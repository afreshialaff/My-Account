# Application connection: a NON-superuser role, so row level security applies.
DATABASE_URL=postgres://aos_app:aos_app_dev@localhost:5432/accounting_os
# Admin connection used only by migrations (creates extensions, the app role and grants).
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/accounting_os
APP_DB_ROLE=aos_app
APP_DB_PASSWORD=aos_app_dev
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
