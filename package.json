{
  "name": "accounting-os",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run start:dev -w @aos/api",
    "dev:web": "npm run dev -w @aos/web",
    "db:migrate": "npm run db:migrate -w @aos/api",
    "db:seed": "npm run db:seed -w @aos/api",
    "test": "npm test -w @aos/api && npm test -w @aos/lite",
    "build": "npm run build -w @aos/api && npm run build -w @aos/web && npm run build -w @aos/lite"
  }
}
